// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model RPSGame {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  interactionId  String @unique
  userId  String
  guildId String
  choice  String
}

model MovieReview {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  movieId String
  guildId String?
  originGuildId String?
  originSource String?
  isPrivate Boolean @default(false)
  updatedAt DateTime?
  score Int
  comment String?
  userId String
  username String
  createdAt DateTime @default(now()) @map("_createdAt")
  sharedFromUserId String?
  sharedFromUsername String?
  sharedFromComment String?
  isQuote Boolean @default(false)

  @@unique([userId, movieId])
  @@index([userId, createdAt])
  @@index([movieId, createdAt])
}

model SeriesReview {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  seriesId String
  guildId String?
  originGuildId String?
  originSource String?
  isPrivate Boolean @default(false)
  updatedAt DateTime?
  score Int
  comment String?
  userId String
  username String
  createdAt DateTime @default(now()) @map("_createdAt")
  sharedFromUserId String?
  sharedFromUsername String?
  sharedFromComment String?
  isQuote Boolean @default(false)

  @@unique([userId, seriesId])
  @@index([userId, createdAt])
  @@index([seriesId, createdAt])
}

model GameReview {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  gameId String
  guildId String?
  originGuildId String?
  originSource String?
  isPrivate Boolean @default(false)
  updatedAt DateTime?
  score Int
  hoursPlayed Int?
  comment String?
  userId String
  username String
  createdAt DateTime @default(now()) @map("_createdAt")
  sharedFromUserId String?
  sharedFromUsername String?
  sharedFromComment String?
  isQuote Boolean @default(false)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
  @@index([gameId, createdAt])
}

enum Replayability {
  LOW
  MEDIUM
  HIGH
}

model MusicReview {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  musicId String
  guildId String?
  originGuildId String?
  originSource String?
  isPrivate Boolean @default(false)
  updatedAt DateTime?
  score Int
  replayability Replayability?
  comment String?
  userId String
  username String
  createdAt DateTime @default(now()) @map("_createdAt")
  sharedFromUserId String?
  sharedFromUsername String?
  sharedFromComment String?
  isQuote Boolean @default(false)

  @@unique([userId, musicId])
  @@index([userId, createdAt])
  @@index([musicId, createdAt])
}

model ReviewPreference {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique
  isPublic Boolean @default(true)
  updatedAt DateTime @default(now())
}

model MediaTitle {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  type String
  mediaId String
  title String
  normalizedTitle String
  imageUrl String?
  fetchedAt DateTime
  @@unique([type, mediaId])
}
